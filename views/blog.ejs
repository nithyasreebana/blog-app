<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageURL %>" width="300px">
        <pre class="mt-3"><%= blog.body %></pre>
    </div>
    <div class="container mt-4">
        <img src="/<%= blog.createdBy.profileImageURL %>" width="40px" height="40"
    class="rounded-circle"><%= blog.createdBy.fullName %>
    <div class="container mt-3">
        <h1>Comments (<%= comments.length %>)</h1>
      <% if(locals.user) { %>
  <form action="/blog/comment/<%= blog._id %>" method="post">
         <div class="mb-3">
    
    <input type="text" name="content" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter Your Comment">
    <button class="btn btn-sm btn-primary" type="Submit">Add</button>
    
  </div>
  </form>
  
  <% } %>
  <div class="mt-3">
    <% comments.forEach(comment => { %>
        <div>
           <img src="/<%= comment.createdBy.profileImageURL %>" width="40px" height="40"
    class="rounded-circle"><%= comment.createdBy.fullName %>   <pre><%= comment.content %></pre>
        </div>
        <% }) %>
  </div>
    </div>
    </div>
    <%- include('./partials/script') %>
</body>
</html>